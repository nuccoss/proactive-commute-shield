# =================================================================
# Proactive Commute Shield Enterprise - Environment Configuration
# =================================================================
# Copy this file to .env and configure keys if live API testing is desired.
# Note: If no keys are provided, the application runs in Fast-Mock mode 100% offline.

# Google Cloud / Vertex AI (Gemini 2.5 Flash ReAct Orchestration)
GOOGLE_CLOUD_PROJECT=demo-commute-shield-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=your_gemini_api_key_here

# Ekispert API (Transit & Delay Detection)
EKISPERT_ACCESS_KEY=your_ekispert_api_key_here
EKISPERT_MCP_PORT=8001

# GMI Cloud NVIDIA H100 (64ms Ultra-Fast Apology & Alert Generation)
GMI_CLOUD_API_KEY=your_gmi_cloud_api_key_here
GMI_CLOUD_ENDPOINT=https://api.gmicloud.ai/v1

# YouCam API (CyberLink 50 AI Skin & Expression First Impression Check)
YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_MCP_PORT=8002

# TrendAI LEARN Blueprint (In-Memory Prompt Injection & Data Loss Prevention Guard)
TRENDAI_TOKEN=your_trendai_token_here

# Fast-Mock Switch (True = offline mock responses, False = live sponsor APIs)
FAST_MOCK_ENABLED=True
